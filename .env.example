# SignVision AI - Environment Configuration Example

# FastAPI Backend Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database Settings
DATABASE_URL=sqlite:///./database/signvision.db

# AI / ML Model Settings
MODEL_WEIGHTS_PATH=./models/gesture_weights.json
CONFIDENCE_THRESHOLD=0.70
TEMPORAL_WINDOW_SIZE=16
FALLBACK_MODE=True

# Speech Settings
DEFAULT_SPEECH_RATE=1.0
DEFAULT_SPEECH_PITCH=1.0
